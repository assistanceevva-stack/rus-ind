{
  "name": "rus-ind",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run dev",
    "verify:docker": "./scripts/verify-docker.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,css,md}": "node scripts/lint-staged-frontend.js",
    "backend/**/*.{mjs,js}": "node scripts/lint-staged-backend.js"
  }
}
