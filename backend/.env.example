# Google Sheets (логи и заявки)
# Без этих переменных бэкенд запустится, но логи/лиды не будут писаться в таблицу
SHEET_ID=
GS_CLIENT_EMAIL=

# GS_PRIVATE_KEY: ключ из Google Cloud Console (JSON service account).
# Вариант 1 — в одну строку с \n: GS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Вариант 2 — многострочно в кавычках (в .env каждая строка — отдельная переменная, поэтому используйте вариант 1)
GS_PRIVATE_KEY=
